# Where EmulatorJS loads its runtime and cores from.
NEXT_PUBLIC_EJS_DATA_PATH=https://cdn.emulatorjs.org/stable/data/
# Base URLs for your own ROM and BIOS files (defaults serve from /public).
NEXT_PUBLIC_ROM_BASE_URL=/roms
NEXT_PUBLIC_BIOS_BASE_URL=/bios
# Set to true only for cores that need threads (PSP, DOS). Adds COOP/COEP headers on /play.
NEXT_PUBLIC_EJS_THREADS=false
# Shows EmulatorJS's experimental netplay menu (2 players online). Turns on the
# emulator's debug mode, which loads its unminified scripts, so leave it off in production.
NEXT_PUBLIC_EJS_NETPLAY=false
# Optional netplay room server. EmulatorJS uses https://netplay.emulatorjs.org when unset.
# NEXT_PUBLIC_EJS_NETPLAY_SERVER=https://netplay.example.com
